# TickerTracker-DataQuest Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# AI ASSISTANT CONFIGURATION
# =============================================================================

# OpenAI Configuration (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=true

# Perplexity AI Configuration (for real-time search capabilities)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_ENABLED=false

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here  
GEMINI_ENABLED=false

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_ENABLED=false

# =============================================================================
# NEWS SERVICE CONFIGURATION
# =============================================================================

# NewsAPI Configuration (for financial news)
NEWS_API_KEY=your_newsapi_key_here
NEWS_API_ENABLED=true

# News Service Settings
NEWS_TRUSTED_SOURCES_ONLY=true
NEWS_ENABLE_READ_LINKS=true
NEWS_LINK_VALIDATION=true

# =============================================================================
# FINANCIAL DATA APIS (if using external services)
# =============================================================================

# Alpha Vantage (for stock data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# CoinGecko (for crypto data - usually free tier available)
COINGECKO_API_KEY=your_coingecko_key_here

# Financial Modeling Prep
FMP_API_KEY=your_fmp_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL (adjust according to your setup)
DATABASE_URL=your_database_connection_string

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment
NODE_ENV=development

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_key_here

# =============================================================================
# API USAGE NOTES
# =============================================================================

# 1. OpenAI: Sign up at https://platform.openai.com/
#    - Recommended for best financial analysis capabilities
#    - Pay-per-use pricing starting at $0.002/1K tokens

# 2. Perplexity AI: Sign up at https://perplexity.ai/
#    - Great for real-time web search and latest news
#    - Free tier available with limited queries

# 3. NewsAPI: Sign up at https://newsapi.org/
#    - Free tier: 1000 requests/day
#    - Essential for trusted financial news sources

# 4. Google Gemini: Get API key from Google AI Studio
#    - Free tier available with generous limits
#    - Good alternative to OpenAI

# 5. Anthropic Claude: Sign up at https://console.anthropic.com/
#    - High-quality responses for financial analysis
#    - Pay-per-use pricing

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env in the root directory
# 2. Sign up for the API services you want to use
# 3. Replace the placeholder values with your actual API keys
# 4. Enable/disable services by setting the *_ENABLED flags to true/false
# 5. Start with OpenAI and NewsAPI for core functionality
# 6. The AI assistant will fallback gracefully if APIs are unavailable

# MINIMUM RECOMMENDED SETUP for basic functionality:
# - OPENAI_API_KEY + OPENAI_ENABLED=true
# - NEWS_API_KEY + NEWS_API_ENABLED=true

# For enhanced real-time capabilities, also add:
# - PERPLEXITY_API_KEY + PERPLEXITY_ENABLED=true