MARKETAUX_API_KEY=demo

# OpenAI API for summaries and Q&A
# Using demo mode for testing
OPENAI_API_KEY=demo
OPENAI_MODEL=gpt-4-turbo-preview

CLIENT_URL=http://localhost:3000
