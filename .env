REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_APP_NAME=TickerTracker
REACT_APP_VERSION=1.0.0
GENERATE_SOURCEMAP=false
# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# AI Assistant Configuration (Fallback Mode)
OPENAI_API_KEY=
OPENAI_ENABLED=false
PERPLEXITY_API_KEY=
PERPLEXITY_ENABLED=false
GEMINI_API_KEY=
GEMINI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=false

# News API Configuration
NEWS_API_KEY=
NEWS_API_ENABLED=false
NEWS_TRUSTED_SOURCES_ONLY=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (Optional for development)
MONGODB_URI=mongodb://localhost:27017/tickertracker
